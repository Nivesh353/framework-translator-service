{
  "name": "gitagent-convert-service",
  "version": "1.0.0",
  "description": "HTTP service that converts any AI agent repo to a target framework using the gitagent sampleagent",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@open-gitagent/gitagent": "^2.0.0",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^5.0.0",
    "express-session": "^1.18.0",
    "multer": "^2.0.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
